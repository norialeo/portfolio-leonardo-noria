# Copie para .env.local e preencha:  cp .env.example .env.local
# Todas são SECRETAS e lidas só no servidor (sem prefixo VITE_):
#   • no npm run dev / preview → vite.config.ts
#   • em produção             → Vercel Functions em api/ (Settings → Environment Variables)
# Sem elas o site funciona; cada recurso só avisa que não está configurado.

# ── Formulário de contato (https://resend.com → API Keys) ─────────────────
RESEND_API_KEY=
# Quem recebe as mensagens (padrão: leonoria09@gmail.com)
# CONTACT_TO_EMAIL=
# Remetente (padrão: onboarding@resend.dev, que funciona sem domínio próprio)
# CONTACT_FROM=

# ── IA do terminal (https://aistudio.google.com/apikey) ─────────────────
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# ── GitHub (opcional: só aumenta o limite de 60 para 5000 req/h) ─────────
# GITHUB_USER=norialeo
# GITHUB_TOKEN=
